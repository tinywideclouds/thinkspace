{
  "compileOnSave": false,
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "esnext",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@org/api/products": ["./packages/api/products/src/index.ts"],
      "@org/models": ["./packages/shared/models/src/index.ts"],
      "@org/shop/data": ["./packages/shop/data/src/index.ts"],
      "@org/shop/feature-product-detail": [
        "./packages/shop/feature-product-detail/src/index.ts"
      ],
      "@org/shop/feature-products": [
        "./packages/shop/feature-products/src/index.ts"
      ],
      "@org/llm-core-protos": ["./libs/llm/core/protos/src/index.ts"],
      "@org/llm-core-transport": ["./libs/llm/core/transport/src/index.ts"],
      "@org/llm-core-facade": ["./libs/llm/core/facade/src/index.ts"],
      "@org/llm-state-chat": ["./libs/llm/state/chat/src/index.ts"],
      "@org/llm-ui-chat": ["./libs/llm/ui/chat/src/index.ts"],
      "@org/contexter-shared": ["./libs/contexter/shared/src/index.ts"],
      "@org/contexter-ui": ["./libs/contexter/ui/src/index.ts"],
      "@org/contexter-data-access": [
        "./libs/contexter/data-access/src/index.ts"
      ],
      "@org/contexter-feature": ["./libs/contexter/feature/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
